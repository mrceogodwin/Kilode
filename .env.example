# Kilode Native (Expo) — public client config only
# Never put service_role, DB passwords, or private API keys in the app.

EXPO_PUBLIC_APP_ENV=development

# Preferred: dedicated Supabase project for Kilode iOS (create in supabase.com)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional custom API / Edge Functions base (leave empty if using Supabase client only)
# EXPO_PUBLIC_API_URL=

# Debug: force seed/offline UI
# EXPO_PUBLIC_FORCE_MOCK=true

# Do NOT set EXPO_PUBLIC_API_URL to kilode-nine.vercel.app or Kilode-v2 for this product.
