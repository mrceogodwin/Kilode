# Kilode Native (Expo) — public client config only
# Never put server secrets, DB passwords, or private API keys here.

# development | preview | production
EXPO_PUBLIC_APP_ENV=development

# Dedicated Kilode API only. Leave blank until that backend is deployed and tested.
# Do NOT use kilode-nine.vercel.app or kilode-v2.vercel.app as a fallback.
EXPO_PUBLIC_API_URL=
