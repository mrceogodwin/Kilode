# Kilode Native (Expo) — public client config only
# Never put server secrets, DB passwords, or private API keys here.

# development | preview | production
EXPO_PUBLIC_APP_ENV=development

# Backend host (Kilode-v2 / Nine). Mobile JSON lives under /api/mobile/*
# Must be the host that deploys Kilode-v2 (not this Expo repo).
EXPO_PUBLIC_API_URL=https://kilode-nine.vercel.app
