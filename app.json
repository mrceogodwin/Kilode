{
  "expo": {
    "name": "Kilode",
    "slug": "kilode",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "kilode",
    "platforms": ["ios", "android"],
    "splash": {
      "backgroundColor": "#0B0B0F",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ng.kilode.app",
      "buildNumber": "1",
      "infoPlist": {
        "UIStatusBarStyle": "UIStatusBarStyleLightContent",
        "NSCameraUsageDescription": "Kilode needs camera for posts and profile.",
        "NSPhotoLibraryUsageDescription": "Kilode needs photos for posts and profile."
      }
    },
    "android": {
      "package": "ng.kilode.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0B0B0F"
      }
    },
    "extra": {
      "eas": {
        "projectId": ""
      },
      "apiUrl": process.env.EXPO_PUBLIC_API_URL || "https://kilode-nine.vercel.app",
      "appEnv": process.env.EXPO_PUBLIC_APP_ENV || "production"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": ["**/*"]
  }
}
