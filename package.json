{
  "name": "kilode",
  "version": "1.0.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "tunnel": "expo start --tunnel",
    "typecheck": "tsc --noEmit",
    "eas:build:ios": "eas build --platform ios --profile production",
    "eas:build:android": "eas build --platform android --profile production",
    "eas:build:preview": "eas build --platform all --profile preview",
    "check:account-capabilities": "node scripts/check-account-capabilities.cjs",
    "test:backend": "node scripts/test-backend-routes.cjs",
    "check:backend-project": "node scripts/check-backend-project.cjs"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "1.23.1",
    "expo": "~52.0.49",
    "expo-av": "~15.0.2",
    "expo-document-picker": "~13.0.3",
    "expo-linear-gradient": "~14.0.2",
    "expo-status-bar": "~2.0.1",
    "react": "18.3.1",
    "react-native": "0.76.9",
    "expo-asset": "~11.0.5",
    "expo-font": "~13.0.4"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~18.3.12",
    "typescript": "~5.3.3"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "expo-av"
        ]
      }
    }
  }
}
