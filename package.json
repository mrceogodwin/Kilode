{
  "name": "kilode",
  "version": "1.0.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "tunnel": "expo start --tunnel",
    "typecheck": "tsc --noEmit",
    "eas:build:ios": "eas build --platform ios --profile production",
    "eas:build:android": "eas build --platform android --profile production",
    "eas:build:preview": "eas build --platform all --profile preview",
    "check:account-capabilities": "node scripts/check-account-capabilities.cjs",
    "test:backend": "node scripts/test-backend-routes.cjs",
    "check:backend-project": "node scripts/check-backend-project.cjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "babel-preset-expo": "~58.0.0",
    "expo": "~58.0.19",
    "expo-asset": "~58.0.18",
    "expo-audio": "~58.0.10",
    "expo-document-picker": "~58.0.4",
    "expo-font": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-video": "~58.0.12",
    "react": "^19.3.0",
    "react-native": "^0.88.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {}
    }
  }
