{
  "name": "kilode",
  "version": "1.0.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "tunnel": "expo start --tunnel",
    "typecheck": "tsc --noEmit",
    "eas:build:ios": "eas build --platform ios --profile production",
    "eas:build:android": "eas build --platform android --profile production",
    "eas:build:preview": "eas build --platform all --profile preview",
    "check:account-capabilities": "node scripts/check-account-capabilities.cjs",
    "test:backend": "node scripts/test-backend-routes.cjs"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "1.23.1",
    "expo": "~51.0.28",
    "expo-av": "~14.0.7",
    "expo-document-picker": "~12.0.2",
    "expo-linear-gradient": "~13.0.2",
    "expo-status-bar": "~1.12.1",
    "react": "18.2.0",
    "react-native": "0.74.5"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/react": "~18.2.0",
    "typescript": "~5.3.0"
  }
}
